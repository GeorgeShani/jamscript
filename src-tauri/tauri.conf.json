{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JamScript",
  "version": "0.3.6",
  "identifier": "com.jamscript.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:desktop-web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:desktop-web",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "JamScript",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A music workbench for code and hands-on controls",
    "longDescription": "Write and play Strudel music in JamScript. Shape rhythms and sound with controls that edit the source code.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "uninstallerHeaderImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
