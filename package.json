{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "bun run emails:build && vite dev",
    "build": "bun run emails:build && vite build",
    "build:desktop-sandbox": "vite build --config vite.sandbox.config.ts --mode desktop",
    "build:desktop-web": "bun run build:desktop-sandbox && vite build --config vite.desktop.config.ts --mode desktop && node scripts/copy-desktop-sandbox.mjs",
    "dev:desktop-web": "bun run build:desktop-sandbox && node scripts/copy-desktop-sandbox.mjs --dev && vite dev --config vite.desktop.config.ts --mode desktop --host 127.0.0.1",
    "desktop:dev": "bun --env-file=.env.local tauri dev",
    "desktop:build": "bun --env-file=.env.local tauri build",
    "build:dev": "bun run emails:build && vite build --mode development",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "perf:database": "bun --env-file=.env --env-file=.env.local scripts/check-database-performance.ts",
    "db:migrate": "drizzle-kit migrate",
    "language:generate": "node scripts/generate-strudel-api.mjs && node scripts/generate-language-libs.mjs",
    "language:audit": "bun scripts/audit-strudel-types.ts",
    "language:server": "bun scripts/strudel-lsp-stdio.ts",
    "lint": "eslint . --max-warnings=0",
    "licenses": "node scripts/collect-licenses.mjs",
    "format": "prettier --write .",
    "test": "bun run emails:build && vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "emails:build": "node scripts/build-emails.mjs",
    "emails:preview": "bun run emails:build && bun scripts/preview-emails.ts"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@breezystack/lamejs": "1.2.7",
    "@clerk/tanstack-react-start": "^1.7.1",
    "@clerk/ui": "^1.40.2",
    "@codemirror/commands": "6",
    "@codemirror/lang-javascript": "6",
    "@codemirror/language": "6",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/search": "6",
    "@codemirror/state": "6",
    "@codemirror/view": "6",
    "@google/genai": "^2.30.0",
    "@lezer/common": "1",
    "@lezer/highlight": "1",
    "@liveblocks/client": "^3.24.3",
    "@liveblocks/node": "^3.24.3",
    "@liveblocks/yjs": "^3.24.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/web": "1.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "json5": "2.2.3",
    "lucide-react": "^0.575.0",
    "motion": "^14.3.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "y-codemirror.next": "^0.3.6",
    "yjs": "^13.6.33",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.24.1",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.32.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "mjml": "5.4.1",
    "prettier": "^3.7.3",
    "rolldown": "1.2.1",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.45.0"
  },
  "license": "AGPL-3.0-or-later"
}
