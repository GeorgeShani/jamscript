# Clerk. The publishable key is browser-safe; keep the secret in the Worker only.
VITE_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Server/CLI only. Supabase PostgreSQL connection string; never expose it with VITE_.
# DATABASE_URL=
# Local-only emulation of the Hyperdrive binding for `bun run dev` / `bun run preview`.
# Use a session-mode (port 5432) Supabase connection string; keep it in .env.local.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_FRESH=

# Browser-safe; needed when Supabase-backed workspaces are implemented.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Liveblocks public/publishable key for intentionally public demo rooms.
# Private collaborative workspaces authenticate through the Worker instead.
# VITE_LIVEBLOCKS_PUBLIC_KEY=

# Worker-only; configure as Cloudflare secrets when their services are implemented.
# LIVEBLOCKS_SECRET_KEY=
# OpenRouter takes priority when its server-only key is configured.
# OPENROUTER_API_KEY=
# OPENROUTER_ASK_MODELS=openai/gpt-6-luna,anthropic/claude-sonnet-5.5,google/gemini-3.8-flash
# OPENROUTER_EDIT_MODELS=openai/gpt-6-sol,anthropic/claude-sonnet-5.5,google/gemini-3.8-flash
# Optional legacy direct Gemini integration when no OpenRouter key is present.
# GEMINI_API_KEY=
# Current Flash model for new projects (do not use gemini-2.5-flash).
# GEMINI_MODEL=gemini-3.8-flash
# SUPABASE_SECRET_KEY=
# Non-secret Worker setting for redirects and invitation links.
APP_ORIGIN=https://jamscript.dev

# Server-only Resend invitation delivery (HTTP; works on Cloudflare Workers).
# Leave blank to show a manual invite link. Store RESEND_API_KEY as a Worker secret in production.
# Testing without a verified domain: MAIL_FROM=JamScript <onboarding@resend.dev>
# RESEND_API_KEY=
# MAIL_FROM=
# Legacy alias RESEND_FROM is also accepted.

# Desktop Git (Tauri only). Optional GitHub OAuth App client id with Device Flow enabled.
# When unset, users paste a fine-grained PAT (stored in the OS keychain):
#   Repository access: only selected song repos
#   Permissions → Contents: Read and write (Metadata Read-only)
# JAMSCRIPT_GITHUB_CLIENT_ID=

# Desktop workbench → Cloudflare Worker API (Assistant Ask/Edit). Browser ignores this.
# JAMSCRIPT_DESKTOP_PUBLIC_API_ORIGIN=https://jamscript.dev

# Desktop JamScript account + private collaboration. Public OAuth client ID and
# Clerk Frontend API origin (for example https://your-instance.clerk.accounts.dev).
# Create a public Clerk OAuth application with Device Authorization Grant and
# scopes openid profile email offline_access; enable the grant on the instance.
# JAMSCRIPT_CLERK_OAUTH_CLIENT_ID=
# JAMSCRIPT_CLERK_FRONTEND_API_URL=
